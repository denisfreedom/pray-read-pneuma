{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "hooks/**/*",
    "utils/**/*",
    "src/**/*",
    "pages/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    ".expo"
  ]
}
